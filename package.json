{
    "name": "haunted-command-station",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Track 2, The Haunted Dashboard: a raw incident report in, a model-composed command station out, live over a WebSocket",
    "engines": {
        "node": ">=24.22.1"
    },
    "packageManager": "pnpm@11.26.0",
    "scripts": {
        "start": "vite build --logLevel warn && node server/main.ts",
        "serve": "node server/main.ts",
        "dev": "node --watch server/main.ts --no-browser",
        "dev:web": "vite",
        "art": "node scripts/art.ts",
        "sfx": "node scripts/sfx.ts",
        "proof": "node scripts/proof.ts",
        "build": "vite build",
        "type-check": "tsc --noEmit && tsc --noEmit -p web",
        "test": "node --test web/src/route.test.ts web/src/layout.test.ts",
        "check": "pnpm run type-check && pnpm run test && pnpm run build"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/vt323": "^5.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "suncalc": "^1.9.0",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/suncalc": "^1.9.2",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^5.2.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.7",
        "vite-plugin-singlefile": "^2.3.4"
    }
}
